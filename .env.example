# ============================================================
# Aegis Cyber — Environment Configuration Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ---- Backend Gateway (backend/.env) ----

# Server port
PORT=5000

# JWT signing secret — use a long, random, unique string in production
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# MongoDB connection string
# Local:   mongodb://127.0.0.1:27017/cyber_defense_platform
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/cyber_defense_platform
MONGO_URI=mongodb://127.0.0.1:27017/cyber_defense_platform

# AI Engine base URL (FastAPI microservice)
AI_ENGINE_URL=http://127.0.0.1:8000

# IPFS / Pinata (optional — falls back to local mock if omitted)
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
PINATA_GATEWAY_URL=https://gateway.pinata.cloud

# Blockchain (Hardhat local node)
HARDHAT_RPC_URL=http://127.0.0.1:8545
# Private key of the deployer wallet (Hardhat test account — never use a real key)
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# ---- Frontend (frontend/.env or vite env) ----
# Vite exposes only VITE_ prefixed vars to the browser
VITE_BACKEND_URL=http://localhost:5000
VITE_AI_ENGINE_URL=http://localhost:8000
